/* NEXUS Dark Theme - Design System */
QMainWindow {
    background-color: #252622;
    color: #F1EADF;
}
QWidget {
    background-color: #252622;
    color: #F1EADF;
    font-family: "Segoe UI";
    font-size: 10pt;
}
QListWidget#sidebar {
    background-color: #2D2E29;
    border-right: 1px solid #49463D;
    outline: none;
}
QListWidget#sidebar::item {
    padding: 11px 12px;
    border-radius: 4px;
    margin: 2px;
    color: #A39E93;
}
QListWidget#sidebar::item:selected {
    background-color: #383933;
    color: #FF985F;
    font-weight: bold;
}
QLabel {
    color: #F1EADF;
    background-color: transparent;
    border: none;
    padding: 0;
}
QFrame#cardsFrame,
QFrame#card,
QFrame#scheduleFrame {
    background-color: transparent;
    border-radius: 8px;
}
QFrame#dashboardHeroCard {
    background-color: #2D2E29;
    border: 1px solid #FF985F;
    border-radius: 6px;
}
QLabel#dashboardHeroTitle {
    font-size: 11pt;
    color: #FF985F;
    font-weight: 700;
    text-transform: uppercase;
}
QLabel#dashboardHeroBadge {
    font-size: 8.5pt;
    color: #252622;
    background-color: #FF985F;
    font-weight: bold;
    padding: 3px 8px;
    border-radius: 4px;
}
QFrame#dashboardPanel,
QFrame#settingsPanel,
QFrame#analyticsPanel,
QFrame#analyticsSummaryCard {
    background-color: #2D2E29;
    border: 1px solid #49463D;
    border-radius: 6px;
}
QFrame#dashboardMetricCard {
    background-color: #2D2E29;
    border: 1px solid #49463D;
    border-radius: 6px;
}
QLabel#welcomeTitle {
    font-size: 24pt;
    font-weight: 700;
    color: #F1EADF;
}
QLabel#welcomeSubtitle {
    font-size: 11pt;
    color: #A39E93;
}
QLabel#dashboardMetricTitle {
    font-size: 9.5pt;
    color: #A39E93;
    font-weight: 600;
}
QLabel#dashboardMetricIndex {
    font-size: 10pt;
    color: #FF985F;
    font-weight: bold;
}
QLabel#dashboardPanelTitle {
    font-size: 13pt;
    font-weight: bold;
    color: #F1EADF;
}
QLabel#dashboardPanelIndex {
    font-size: 11pt;
    color: #FF985F;
    font-weight: bold;
}
QPushButton {
    background-color: #2D2E29;
    border: 1px solid #49463D;
    padding: 9px 14px;
    min-height: 20px;
    border-radius: 4px;
    color: #F1EADF;
}
QPushButton:hover {
    background-color: #363732;
    border-color: #FF985F;
}
QPushButton:pressed {
    background-color: #22231F;
}
/* Unified Button Design System (Dark Mode) */
QPushButton#addSubjectButton,
QPushButton#addExamButton,
QPushButton#importFilesButton,
QPushButton#addAssignmentButton,
QPushButton#addNoteButton,
QPushButton#saveAttendanceButton,
QPushButton#subjectSaveButton,
QPushButton#saveAssignmentButton,
QPushButton#saveExamButton,
QPushButton#saveNoteButton,
QPushButton#saveSettingsButton {
    background-color: #FF985F;
    color: #252622;
    border: none;
    font-weight: bold;
    border-radius: 6px;
    padding: 10px 18px;
}
QPushButton#addSubjectButton:hover,
QPushButton#addExamButton:hover,
QPushButton#importFilesButton:hover,
QPushButton#addAssignmentButton:hover,
QPushButton#addNoteButton:hover,
QPushButton#saveAttendanceButton:hover,
QPushButton#subjectSaveButton:hover,
QPushButton#saveAssignmentButton:hover,
QPushButton#saveExamButton:hover,
QPushButton#saveNoteButton:hover,
QPushButton#saveSettingsButton:hover {
    background-color: #E6854D;
}

QPushButton#editSubjectButton,
QPushButton#editExamButton,
QPushButton#editAssignmentButton,
QPushButton#editNoteButton,
QPushButton#editTimetableButton,
QPushButton#editAttendanceButton,
QPushButton#openStudyFileButton {
    background-color: #36322B;
    border: 1px solid #524B40;
    color: #FF985F;
    border-radius: 6px;
    padding: 6px 12px;
    font-weight: 600;
}
QPushButton#editSubjectButton:hover,
QPushButton#editExamButton:hover,
QPushButton#editAssignmentButton:hover,
QPushButton#editNoteButton:hover,
QPushButton#editTimetableButton:hover,
QPushButton#editAttendanceButton:hover,
QPushButton#openStudyFileButton:hover {
    background-color: #423C33;
    border-color: #FF985F;
}

QPushButton#deleteSubjectButton,
QPushButton#deleteExamButton,
QPushButton#deleteAssignmentButton,
QPushButton#deleteNoteButton,
QPushButton#deleteTimetableButton,
QPushButton#deleteAttendanceButton,
QPushButton#deleteStudyFileButton {
    background-color: #3B2020;
    border: 1px solid #7F2D2D;
    color: #F87171;
    border-radius: 6px;
    padding: 6px 12px;
    font-weight: 600;
}
QPushButton#deleteSubjectButton:hover,
QPushButton#deleteExamButton:hover,
QPushButton#deleteAssignmentButton:hover,
QPushButton#deleteNoteButton:hover,
QPushButton#deleteTimetableButton:hover,
QPushButton#deleteAttendanceButton:hover,
QPushButton#deleteStudyFileButton:hover {
    background-color: #4A2828;
    border-color: #EF4444;
}

QWidget#assignmentActionWidget,
QWidget#subjectActionWidget,
QWidget#timetableActionWidget,
QWidget#examActionWidget,
QWidget#noteActionWidget,
QWidget#libraryActionWidget {
    background-color: transparent;
}
QLabel#assignmentFieldLabel {
    background-color: #2D2E29;
    padding: 5px 8px;
    border-radius: 4px;
    color: #F1EADF;
}
QLineEdit,
QComboBox,
QAbstractSpinBox,
QTextEdit {
    background-color: #2D2E29;
    border: 1px solid #49463D;
    border-radius: 4px;
    padding: 8px 9px;
    min-height: 20px;
    color: #F1EADF;
}
QLineEdit:focus,
QComboBox:focus,
QAbstractSpinBox:focus,
QTextEdit:focus {
    border: 1px solid #FF985F;
}
QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox QAbstractItemView {
    background-color: #2D2E29;
    border: 1px solid #49463D;
    selection-background-color: #383933;
    selection-color: #FF985F;
    color: #F1EADF;
    padding: 4px;
}
QComboBox QAbstractItemView::item {
    padding: 6px 8px;
}
QTableWidget {
    background-color: #2D2E29;
    alternate-background-color: #252622;
    gridline-color: #49463D;
    color: #F1EADF;
    border: 1px solid #49463D;
    border-radius: 6px;
}
QTableWidget::item {
    padding: 8px;
    border-bottom: 1px solid #49463D;
}
QTableWidget::item:selected {
    background-color: #383933;
    color: #FF985F;
}
QHeaderView::section {
    background-color: #252622;
    color: #A39E93;
    padding: 7px 8px;
    border: none;
    border-bottom: 1px solid #49463D;
    font-weight: bold;
}
QListWidget {
    background-color: #2D2E29;
    border: 1px solid #49463D;
    border-radius: 6px;
    color: #F1EADF;
}
QListWidget::item {
    padding: 8px;
    border-bottom: 1px solid #49463D;
}
QListWidget::item:selected {
    background-color: #383933;
    color: #FF985F;
}
QProgressBar {
    background-color: #2D2E29;
    border: 1px solid #49463D;
    border-radius: 4px;
    text-align: center;
    color: #F1EADF;
}
QProgressBar::chunk {
    background-color: #FF985F;
    border-radius: 4px;
}
QDialog,
QMessageBox {
    background-color: #252622;
    color: #F1EADF;
}
QMessageBox QLabel {
    color: #F1EADF;
}
QScrollArea {
    background-color: transparent;
    border: none;
}
QScrollBar:vertical {
    background-color: #252622;
    width: 10px;
    margin: 0px;
    border-radius: 5px;
}
QScrollBar::handle:vertical {
    background-color: #49463D;
    border-radius: 5px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover {
    background-color: #5E5A50;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
